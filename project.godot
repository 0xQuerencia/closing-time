; Closing Time — environment milestone
config_version=5
[application]
config/name="Closing Time"
run/main_scene="res://scenes/world/market_root.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=true
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
[debug]
settings/stdout/verbose_stdout=true
